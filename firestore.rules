rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Connectivity probe endpoint (get-only)
    match /test/connection {
      allow get: if true;
    }

    // =========================================================================
    // Global Hardened Primitives
    // =========================================================================
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'midulhasan000888@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isOptionalString(data, key, maxLen) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxLen);
    }

    function isOptionalNumber(data, key) {
      return !(key in data) || (data[key] is number);
    }

    function isOptionalBoundedList(data, key, maxLen) {
      return !(key in data) || (data[key] is list && data[key].size() <= maxLen);
    }

    function isOptionalBool(data, key) {
      return !(key in data) || (data[key] is bool);
    }

    // =========================================================================
    // Validation Blueprints (Anti-Update-Gap Helpers)
    // =========================================================================
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'language', 'theme', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'uid', 'email', 'displayName', 'photoURL', 'role', 'language', 'theme', 'primaryColor', 'secondaryColor', 'themePreset', 'timezone', 'status',
          'mobile', 'dateOfBirth', 'gender', 'country', 'division', 'district', 'city', 'address',
          'educationLevel', 'institutionName', 'department', 'subject', 'classOrSemester', 'passingYear', 'qualification',
          'profession', 'jobTitle', 'companyName', 'workDepartment', 'workExperience', 'skills', 'specialization', 'engineeringDiscipline', 'designation', 'licenseNumber',
          'accountType', 'storageLimitMb', 'loginCount', 'lastLoginAtIso', 'deletionRequested', 'deletionRequestedAtIso',
          'defaultCalculator', 'preferredUnitSystem', 'inAppNotifications', 'emailNotifications', 'profileVisibility',
          'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid == userId && data.uid.size() <= 128
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && isOptionalString(data, 'photoURL', 300000)
        && data.role in ['user', 'engineer', 'admin']
        && data.language in ['en', 'bn']
        && data.theme in ['light', 'dark']
        && isOptionalString(data, 'primaryColor', 20)
        && isOptionalString(data, 'secondaryColor', 20)
        && isOptionalString(data, 'themePreset', 40)
        && isOptionalString(data, 'timezone', 80)
        && data.status in ['active', 'suspended']
        && isOptionalString(data, 'mobile', 60)
        && isOptionalString(data, 'dateOfBirth', 30)
        && isOptionalString(data, 'gender', 40)
        && isOptionalString(data, 'country', 100)
        && isOptionalString(data, 'division', 100)
        && isOptionalString(data, 'district', 100)
        && isOptionalString(data, 'city', 100)
        && isOptionalString(data, 'address', 320)
        && isOptionalString(data, 'educationLevel', 100)
        && isOptionalString(data, 'institutionName', 200)
        && isOptionalString(data, 'department', 160)
        && isOptionalString(data, 'subject', 160)
        && isOptionalString(data, 'classOrSemester', 100)
        && isOptionalString(data, 'passingYear', 20)
        && isOptionalString(data, 'qualification', 160)
        && isOptionalString(data, 'profession', 160)
        && isOptionalString(data, 'jobTitle', 160)
        && isOptionalString(data, 'companyName', 200)
        && isOptionalString(data, 'workDepartment', 160)
        && isOptionalString(data, 'workExperience', 80)
        && isOptionalString(data, 'skills', 320)
        && isOptionalString(data, 'specialization', 200)
        && isOptionalString(data, 'engineeringDiscipline', 160)
        && isOptionalString(data, 'designation', 160)
        && isOptionalString(data, 'licenseNumber', 120)
        && (!('accountType' in data) || data.accountType in ['free', 'premium', 'custom'])
        && isOptionalNumber(data, 'storageLimitMb')
        && isOptionalNumber(data, 'loginCount')
        && isOptionalString(data, 'lastLoginAtIso', 40)
        && isOptionalBool(data, 'deletionRequested')
        && isOptionalString(data, 'deletionRequestedAtIso', 40)
        && (!('defaultCalculator' in data) || data.defaultCalculator in ['normal', 'scientific', 'engineering'])
        && (!('preferredUnitSystem' in data) || data.preferredUnitSystem in ['SI', 'Imperial', 'Mixed'])
        && isOptionalBool(data, 'inAppNotifications')
        && isOptionalBool(data, 'emailNotifications')
        && (!('profileVisibility' in data) || data.profileVisibility in ['private', 'team'])
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminMarker(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'grantedBy', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'grantedBy', 'createdAt'])
        && data.uid is string && data.uid == userId && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 200
        && data.grantedBy is string && data.grantedBy.size() <= 128
        && data.createdAt is timestamp;
    }

    function isValidRoleDefinition(data, roleId) {
      return data.keys().hasAll(['id', 'name', 'permissions', 'updatedAt'])
        && data.keys().hasOnly(['id', 'name', 'permissions', 'updatedAt'])
        && data.id is string && data.id == roleId && data.id.size() <= 64
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.permissions is list && data.permissions.size() <= 30
        && (data.permissions.size() == 0 || (data.permissions[0] is string && data.permissions[0].size() <= 80))
        && data.updatedAt is timestamp;
    }

    function isValidCategory(data, categoryId) {
      return data.keys().hasAll(['id', 'slug', 'nameEn', 'nameBn', 'order', 'enabled', 'updatedAt'])
        && data.keys().hasOnly(['id', 'slug', 'nameEn', 'nameBn', 'descriptionEn', 'descriptionBn', 'icon', 'order', 'enabled', 'updatedAt'])
        && data.id is string && data.id == categoryId && data.id.size() <= 64
        && data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 64
        && data.nameEn is string && data.nameEn.size() >= 1 && data.nameEn.size() <= 120
        && data.nameBn is string && data.nameBn.size() >= 1 && data.nameBn.size() <= 120
        && isOptionalString(data, 'descriptionEn', 400)
        && isOptionalString(data, 'descriptionBn', 400)
        && isOptionalString(data, 'icon', 60)
        && data.order is number
        && data.enabled is bool
        && data.updatedAt is timestamp;
    }

    function isValidCalculator(data, calculatorId) {
      return data.keys().hasAll(['id', 'categoryId', 'nameEn', 'nameBn', 'formulaDisplay', 'inputs', 'outputs', 'version', 'enabled', 'published', 'updatedAt'])
        && data.keys().hasOnly(['id', 'categoryId', 'nameEn', 'nameBn', 'descriptionEn', 'descriptionBn', 'formulaDisplay', 'formulaReference', 'explanationEn', 'explanationBn', 'disclaimerEn', 'disclaimerBn', 'inputs', 'outputs', 'conditions', 'exampleInputs', 'version', 'enabled', 'published', 'updatedBy', 'updatedAt'])
        && data.id is string && data.id == calculatorId && data.id.size() <= 100
        && data.categoryId is string && data.categoryId.size() >= 1 && data.categoryId.size() <= 64
        && data.nameEn is string && data.nameEn.size() >= 1 && data.nameEn.size() <= 160
        && data.nameBn is string && data.nameBn.size() >= 1 && data.nameBn.size() <= 160
        && isOptionalString(data, 'descriptionEn', 600)
        && isOptionalString(data, 'descriptionBn', 600)
        && data.formulaDisplay is string && data.formulaDisplay.size() >= 1 && data.formulaDisplay.size() <= 300
        && isOptionalString(data, 'formulaReference', 400)
        && isOptionalString(data, 'explanationEn', 1200)
        && isOptionalString(data, 'explanationBn', 1200)
        && isOptionalString(data, 'disclaimerEn', 600)
        && isOptionalString(data, 'disclaimerBn', 600)
        && data.inputs is list && data.inputs.size() <= 25
        && data.outputs is list && data.outputs.size() >= 1 && data.outputs.size() <= 20
        && isOptionalBoundedList(data, 'conditions', 20)
        && (!('exampleInputs' in data) || data.exampleInputs is map)
        && data.version is number
        && data.enabled is bool
        && data.published is bool
        && isOptionalString(data, 'updatedBy', 128)
        && data.updatedAt is timestamp;
    }

    function isValidFormulaRecord(data, formulaId) {
      return data.keys().hasAll(['id', 'calculatorId', 'expression', 'version', 'updatedAt'])
        && data.keys().hasOnly(['id', 'calculatorId', 'expression', 'version', 'updatedAt'])
        && data.id is string && data.id == formulaId && data.id.size() <= 100
        && data.calculatorId is string && data.calculatorId.size() <= 100
        && data.expression is string && data.expression.size() >= 1 && data.expression.size() <= 500
        && data.version is number
        && data.updatedAt is timestamp;
    }

    function isValidFormulaVersion(data, versionId) {
      return data.keys().hasAll(['id', 'calculatorId', 'version', 'snapshot', 'createdBy', 'createdAt'])
        && data.keys().hasOnly(['id', 'calculatorId', 'version', 'snapshot', 'changeNote', 'createdBy', 'createdAt'])
        && data.id is string && data.id == versionId && data.id.size() <= 128
        && data.calculatorId is string && data.calculatorId.size() <= 100
        && data.version is number
        && data.snapshot is map
        && isOptionalString(data, 'changeNote', 300)
        && data.createdBy is string && data.createdBy.size() <= 128
        && data.createdAt is timestamp;
    }

    function isValidUnit(data, unitId) {
      return data.keys().hasAll(['id', 'dimension', 'symbol', 'nameEn', 'toBaseFactor', 'enabled', 'updatedAt'])
        && data.keys().hasOnly(['id', 'dimension', 'symbol', 'nameEn', 'nameBn', 'toBaseFactor', 'enabled', 'updatedAt'])
        && data.id is string && data.id == unitId && data.id.size() <= 64
        && data.dimension is string && data.dimension.size() >= 1 && data.dimension.size() <= 64
        && data.symbol is string && data.symbol.size() >= 1 && data.symbol.size() <= 24
        && data.nameEn is string && data.nameEn.size() >= 1 && data.nameEn.size() <= 80
        && isOptionalString(data, 'nameBn', 80)
        && data.toBaseFactor is number
        && data.enabled is bool
        && data.updatedAt is timestamp;
    }

    function isValidCalculationHistory(data, historyId) {
      return data.keys().hasAll(['id', 'userId', 'calculatorId', 'calculatorNameEn', 'inputs', 'outputs', 'isSaved', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'calculatorId', 'calculatorNameEn', 'calculatorNameBn', 'categoryId', 'inputs', 'outputs', 'formulaDisplay', 'note', 'isSaved', 'createdAt'])
        && data.id is string && data.id == historyId && data.id.size() <= 128
        && data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128
        && data.calculatorId is string && data.calculatorId.size() <= 100
        && data.calculatorNameEn is string && data.calculatorNameEn.size() <= 160
        && isOptionalString(data, 'calculatorNameBn', 160)
        && isOptionalString(data, 'categoryId', 64)
        && data.inputs is map
        && data.outputs is map
        && isOptionalString(data, 'formulaDisplay', 300)
        && isOptionalString(data, 'note', 600)
        && data.isSaved is bool
        && data.createdAt is timestamp;
    }

    function isValidReportTemplate(data, templateId) {
      return data.keys().hasAll(['id', 'nameEn', 'nameBn', 'orientation', 'showSignature', 'enabled', 'updatedAt'])
        && data.keys().hasOnly(['id', 'nameEn', 'nameBn', 'category', 'descriptionEn', 'descriptionBn', 'recommended', 'lockedByAdmin', 'orientation', 'headerText', 'footerText', 'accentColor', 'showSignature', 'showChart', 'customFields', 'pageDesign', 'blocks', 'enabled', 'updatedBy', 'updatedAt'])
        && data.id is string && data.id == templateId && data.id.size() <= 100
        && data.nameEn is string && data.nameEn.size() >= 1 && data.nameEn.size() <= 140
        && data.nameBn is string && data.nameBn.size() >= 1 && data.nameBn.size() <= 140
        && isOptionalString(data, 'category', 60)
        && isOptionalString(data, 'descriptionEn', 400)
        && isOptionalString(data, 'descriptionBn', 400)
        && (!('recommended' in data) || data.recommended is bool)
        && (!('lockedByAdmin' in data) || data.lockedByAdmin is bool)
        && data.orientation in ['portrait', 'landscape']
        && isOptionalString(data, 'headerText', 300)
        && isOptionalString(data, 'footerText', 300)
        && isOptionalString(data, 'accentColor', 20)
        && data.showSignature is bool
        && (!('showChart' in data) || data.showChart is bool)
        && isOptionalBoundedList(data, 'customFields', 20)
        && (!('pageDesign' in data) || data.pageDesign is map)
        && isOptionalBoundedList(data, 'blocks', 80)
        && data.enabled is bool
        && isOptionalString(data, 'updatedBy', 128)
        && data.updatedAt is timestamp;
    }

    function isValidGeneratedReport(data, reportId) {
      return data.keys().hasAll(['id', 'userId', 'templateId', 'reportNumber', 'title', 'orientation', 'payload', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'templateId', 'reportNumber', 'title', 'companyName', 'projectName', 'category', 'orientation', 'payload', 'pageDesign', 'blocks', 'pdfStoragePath', 'pdfDownloadUrl', 'pdfFileSizeBytes', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == reportId && data.id.size() <= 128
        && data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128
        && data.templateId is string && data.templateId.size() <= 100
        && data.reportNumber is string && data.reportNumber.size() <= 64
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && isOptionalString(data, 'companyName', 160)
        && isOptionalString(data, 'projectName', 160)
        && isOptionalString(data, 'category', 60)
        && data.orientation in ['portrait', 'landscape']
        && data.payload is map
        && (!('pageDesign' in data) || data.pageDesign is map)
        && isOptionalBoundedList(data, 'blocks', 80)
        && isOptionalString(data, 'pdfStoragePath', 400)
        && isOptionalString(data, 'pdfDownloadUrl', 1200)
        && (!('pdfFileSizeBytes' in data) || (data.pdfFileSizeBytes is number && data.pdfFileSizeBytes >= 0))
        && data.createdAt is timestamp
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidCalendarEvent(data, eventId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'date', 'repeat', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'title', 'description', 'date', 'time', 'repeat', 'attachedNoteId', 'category', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == eventId && data.id.size() <= 128
        && data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && isOptionalString(data, 'description', 800)
        && data.date is string && data.date.size() <= 20
        && isOptionalString(data, 'time', 20)
        && data.repeat in ['none', 'daily', 'weekly', 'monthly', 'yearly']
        && isOptionalString(data, 'attachedNoteId', 128)
        && isOptionalString(data, 'category', 60)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidReminder(data, reminderId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'date', 'time', 'repeat', 'priority', 'completed', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'title', 'description', 'date', 'time', 'repeat', 'customIntervalDays', 'priority', 'completed', 'location', 'notified', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == reminderId && data.id.size() <= 128
        && data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && isOptionalString(data, 'description', 600)
        && data.date is string && data.date.size() <= 20
        && data.time is string && data.time.size() <= 20
        && data.repeat in ['none', 'daily', 'weekly', 'monthly', 'yearly', 'custom']
        && isOptionalNumber(data, 'customIntervalDays')
        && data.priority in ['low', 'medium', 'high']
        && data.completed is bool
        && isOptionalString(data, 'location', 200)
        && (!('notified' in data) || data.notified is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidNotification(data, notificationId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'body', 'type', 'read', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'title', 'body', 'type', 'read', 'createdAt'])
        && data.id is string && data.id == notificationId && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.body is string && data.body.size() <= 600
        && data.type in ['reminder', 'system', 'broadcast']
        && data.read is bool
        && data.createdAt is timestamp;
    }

    function isValidPersonalNote(data, noteId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'content', 'category', 'pinned', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'title', 'content', 'category', 'pinned', 'date', 'imageDataUrl', 'locationLabel', 'latitude', 'longitude', 'linkedEventId', 'linkedCalculationId', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == noteId && data.id.size() <= 128
        && data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 180
        && data.content is string && data.content.size() <= 12000
        && data.category is string && data.category.size() <= 60
        && data.pinned is bool
        && isOptionalString(data, 'date', 20)
        && isOptionalString(data, 'imageDataUrl', 350000)
        && isOptionalString(data, 'locationLabel', 200)
        && isOptionalNumber(data, 'latitude')
        && isOptionalNumber(data, 'longitude')
        && isOptionalString(data, 'linkedEventId', 128)
        && isOptionalString(data, 'linkedCalculationId', 128)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAppSetting(data, settingId) {
      return data.keys().hasAll(['id', 'platformNameEn', 'defaultLanguage', 'maintenanceMode', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'platformNameEn', 'platformNameBn', 'defaultLanguage', 'hijriOffsetDays',
          'banglaCalendarVariant', 'maintenanceMode', 'announcementBanner', 'aiPdfConfig',
          'moduleFlags', 'translateConfig', 'dictionaryConfig', 'calculatorConfig',
          'storageConfig', 'profileConfig', 'updatedAt'
        ])
        && data.id is string && data.id == settingId && data.id.size() <= 64
        && data.platformNameEn is string && data.platformNameEn.size() <= 100
        && isOptionalString(data, 'platformNameBn', 100)
        && data.defaultLanguage in ['en', 'bn']
        && isOptionalNumber(data, 'hijriOffsetDays')
        && (!('banglaCalendarVariant' in data) || data.banglaCalendarVariant in ['revised', 'traditional'])
        && data.maintenanceMode is bool
        && isOptionalString(data, 'announcementBanner', 300)
        && (!('aiPdfConfig' in data) || data.aiPdfConfig is map)
        && (!('moduleFlags' in data) || data.moduleFlags is map)
        && (!('translateConfig' in data) || data.translateConfig is map)
        && (!('dictionaryConfig' in data) || data.dictionaryConfig is map)
        && (!('calculatorConfig' in data) || data.calculatorConfig is map)
        && (!('storageConfig' in data) || data.storageConfig is map)
        && (!('profileConfig' in data) || data.profileConfig is map)
        && data.updatedAt is timestamp;
    }

    function isValidAuditLog(data, logId) {
      return data.keys().hasAll(['id', 'actorUid', 'action', 'targetCollection', 'targetId', 'summary', 'createdAt'])
        && data.keys().hasOnly(['id', 'actorUid', 'actorEmail', 'action', 'targetCollection', 'targetId', 'summary', 'createdAt'])
        && data.id is string && data.id == logId && data.id.size() <= 128
        && data.actorUid is string && data.actorUid == request.auth.uid && data.actorUid.size() <= 128
        && isOptionalString(data, 'actorEmail', 200)
        && data.action is string && data.action.size() <= 120
        && data.targetCollection is string && data.targetCollection.size() <= 80
        && data.targetId is string && data.targetId.size() <= 128
        && data.summary is string && data.summary.size() <= 400
        && data.createdAt is timestamp;
    }

    function isValidPdfDocument(data, docId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'fileName', 'category', 'specialty', 'fileSizeBytes', 'pageCount', 'ocrPagesCount', 'processingStatus', 'processingProgress', 'sharedWithLink', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'title', 'fileName', 'category', 'specialty', 'fileSizeBytes', 'pageCount', 'ocrPagesCount', 'processingStatus', 'processingProgress', 'processingError', 'storagePath', 'downloadUrl', 'sourceType', 'sourceUrl', 'sourceUrls', 'mimeType', 'documentType', 'summaryEn', 'summaryBn', 'keyFindings', 'extractedNumbers', 'extractedFormulas', 'extractedSpecs', 'extractedTables', 'warnings', 'sharedWithLink', 'folderId', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == docId && data.id.size() <= 128
        && data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 240
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 40
        && data.specialty in ['general', 'electrical', 'mechanical', 'civil']
        && data.fileSizeBytes is number && data.fileSizeBytes >= 0
        && data.pageCount is number && data.pageCount >= 0
        && data.ocrPagesCount is number && data.ocrPagesCount >= 0
        && data.processingStatus in ['uploading', 'extracting', 'analyzing', 'ready', 'error']
        && data.processingProgress is number && data.processingProgress >= 0 && data.processingProgress <= 100
        && isOptionalString(data, 'processingError', 600)
        && isOptionalString(data, 'storagePath', 400)
        && isOptionalString(data, 'downloadUrl', 1200)
        && (!('sourceType' in data) || data.sourceType in ['pdf', 'text', 'url', 'multi_url', 'document', 'image'])
        && isOptionalString(data, 'sourceUrl', 1200)
        && isOptionalBoundedList(data, 'sourceUrls', 20)
        && isOptionalString(data, 'mimeType', 120)
        && isOptionalString(data, 'documentType', 140)
        && isOptionalString(data, 'summaryEn', 6000)
        && isOptionalString(data, 'summaryBn', 6000)
        && isOptionalBoundedList(data, 'keyFindings', 50)
        && isOptionalBoundedList(data, 'extractedNumbers', 120)
        && isOptionalBoundedList(data, 'extractedFormulas', 40)
        && isOptionalBoundedList(data, 'extractedSpecs', 80)
        && isOptionalBoundedList(data, 'extractedTables', 20)
        && isOptionalBoundedList(data, 'warnings', 40)
        && data.sharedWithLink is bool
        && isOptionalString(data, 'folderId', 128)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPdfPage(data, docId, pageId) {
      return data.keys().hasAll(['id', 'documentId', 'userId', 'pageNumber', 'text', 'isScanned', 'ocrApplied', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'documentId', 'userId', 'pageNumber', 'text', 'isScanned', 'ocrApplied', 'diagramSummary', 'thumbnailDataUrl', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == pageId && data.id.size() <= 64
        && data.documentId is string && data.documentId == docId && data.documentId.size() <= 128
        && data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128
        && data.pageNumber is number && data.pageNumber >= 1
        && data.text is string && data.text.size() <= 35000
        && data.isScanned is bool
        && data.ocrApplied is bool
        && isOptionalString(data, 'diagramSummary', 5000)
        && isOptionalString(data, 'thumbnailDataUrl', 180000)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPdfChat(data, chatId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'documentIds', 'messages', 'createdAt', 'updatedAt'])
