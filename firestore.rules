        && incoming().updatedAt == request.time;
      allow update: if isValidId(jobId)
        && isVerifiedUser()
        && existing().userId == request.auth.uid
        && isValidGoogleSyncJob(incoming(), jobId)
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(jobId) && isSignedIn() && existing().userId == request.auth.uid;
    }

    // Google Sync Execution Logs (Owner scoped, Admin readable, append-only)
    match /googleSyncLogs/{logId} {
      allow get: if isValidId(logId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(logId)
        && isVerifiedUser()
        && isValidGoogleSyncLog(incoming(), logId)
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(logId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    // Automatic Update Schedules (Strictly Private to Owner)
    match /updateSchedules/{scheduleId} {
      allow get: if isValidId(scheduleId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update: if isValidId(scheduleId)
        && isVerifiedUser()
        && isValidUpdateSchedule(incoming(), scheduleId)
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(scheduleId) && isSignedIn() && existing().userId == request.auth.uid;
    }

    // Automatic Update Execution Logs (Owner scoped, Admin readable, append-only)
    match /updateLogs/{logId} {
      allow get: if isValidId(logId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(logId)
        && isVerifiedUser()
        && isValidUpdateLog(incoming(), logId)
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(logId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    // User Exports Archive (Owner scoped)
    match /userExports/{exportId} {
      allow get: if isValidId(exportId) && isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isValidId(exportId)
        && isVerifiedUser()
        && isValidUserExport(incoming(), exportId)
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(exportId) && isSignedIn() && existing().userId == request.auth.uid;
    }

    // =========================================================================
    // Feature Expansion Collection Rules (Translate, Dictionary, Storage, Suggestions, Designer)
    // =========================================================================

    // PDF Folders (Strictly Private to Owner)
    match /pdfFolders/{folderId} {
      allow get: if isValidId(folderId) && isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isValidId(folderId)
        && isVerifiedUser()
        && isValidPdfFolder(incoming(), folderId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(folderId)
        && isVerifiedUser()
        && existing().userId == request.auth.uid
        && isValidPdfFolder(incoming(), folderId)
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'color', 'updatedAt']);
      allow delete: if isValidId(folderId) && isSignedIn() && existing().userId == request.auth.uid;
    }

    // User PDF Storage Usage (Owner write/read, Admin read)
    match /userStorageUsage/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create, update: if isValidId(userId)
        && isVerifiedUser()
        && isOwner(userId)
        && isValidUserStorageUsage(incoming(), userId)
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(userId) && isAdmin();
    }

    // Translation History (Strictly Private to Owner)
    match /translationHistory/{historyId} {
      allow get: if isValidId(historyId) && isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isValidId(historyId)
        && isVerifiedUser()
        && isValidTranslationHistory(incoming(), historyId)
        && incoming().createdAt == request.time;
      allow update: if isValidId(historyId)
        && isVerifiedUser()
        && existing().userId == request.auth.uid
        && isValidTranslationHistory(incoming(), historyId)
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['isFavourite']);
      allow delete: if isValidId(historyId) && isSignedIn() && existing().userId == request.auth.uid;
    }

    // Favourite Translations (Strictly Private to Owner)
    match /favouriteTranslations/{favId} {
      allow get: if isValidId(favId) && isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isValidId(favId)
        && isVerifiedUser()
        && isValidFavouriteTranslation(incoming(), favId)
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(favId) && isSignedIn() && existing().userId == request.auth.uid;
    }

    // Dictionary Lookup History (Strictly Private to Owner)
    match /dictionaryHistory/{historyId} {
      allow get: if isValidId(historyId) && isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isValidId(historyId)
        && isVerifiedUser()
        && isValidDictionaryHistory(incoming(), historyId)
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(historyId) && isSignedIn() && existing().userId == request.auth.uid;
    }

    // Favourite Vocabulary Words (Strictly Private to Owner)
    match /favouriteWords/{favId} {
      allow get: if isValidId(favId) && isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isValidId(favId)
        && isVerifiedUser()
        && isValidFavouriteWord(incoming(), favId)
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(favId) && isSignedIn() && existing().userId == request.auth.uid;
    }

    // Calculator History (Normal, Scientific & Engineering - Owner write, Admin readable)
    match /calculatorHistory/{historyId} {
      allow get: if isValidId(historyId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(historyId)
        && isVerifiedUser()
        && isValidCalculatorHistory(incoming(), historyId)
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(historyId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    // Suggestions & Feedback (Signed-in public board OR Owner private OR Admin)
    match /suggestions/{suggestionId} {
      allow get: if isValidId(suggestionId) && isSignedIn() && (existing().visibility == 'public' || existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.visibility == 'public' || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(suggestionId)
        && isVerifiedUser()
        && isValidSuggestion(incoming(), suggestionId)
        && incoming().userId == request.auth.uid
        && incoming().status == 'Submitted'
        && incoming().voteCount == 0
        && !('adminReply' in incoming())
        && !('internalNote' in incoming())
        && !('isImportant' in incoming())
        && !('isDevelopmentTask' in incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(suggestionId)
        && isVerifiedUser()
        && isValidSuggestion(incoming(), suggestionId)
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && (
          (
            isAdmin()
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminReply', 'internalNote', 'isImportant', 'isDevelopmentTask', 'updatedAt'])
          ) ||
          (
            existing().visibility == 'public'
            && incoming().updatedAt == existing().updatedAt
            && incoming().diff(existing()).affectedKeys().hasOnly(['voteCount'])
            && (incoming().voteCount == existing().voteCount + 1 || incoming().voteCount == existing().voteCount - 1)
          )
        );
      allow delete: if isValidId(suggestionId) && isAdmin();
    }

    // Suggestion Votes (1 vote per user per suggestion)
    match /suggestionVotes/{voteId} {
      allow get: if isValidId(voteId) && isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isValidId(voteId)
        && isVerifiedUser()
        && isValidSuggestionVote(incoming(), voteId)
        && voteId == (incoming().suggestionId + '_' + request.auth.uid)
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/suggestions/$(incoming().suggestionId));
      allow update: if false;
      allow delete: if isValidId(voteId) && isSignedIn() && existing().userId == request.auth.uid;
    }

    // Designer Information (Public get, Admin write)
    match /designerInformation/{infoId} {
      allow get: if isValidId(infoId);
      allow list: if false;
      allow create, update: if isValidId(infoId)
        && isAdmin()
        && isValidDesignerInfo(incoming(), infoId)
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // API Usage Logs (Owner create, Owner or Admin read)
    match /apiUsageLogs/{logId} {
      allow get: if isValidId(logId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(logId)
        && isVerifiedUser()
        && isValidApiUsageLog(incoming(), logId)
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(logId) && isAdmin();
    }

    // User Activity Logs (Owner create, Owner or Admin read)
    match /userActivityLogs/{logId} {
      allow get: if isValidId(logId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(logId)
        && isVerifiedUser()
        && isValidUserActivityLog(incoming(), logId)
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(logId) && isAdmin();
    }
  }
}
