      return data.keys().hasAll(['id', 'preferredProvider', 'defaultBaseCurrency', 'defaultTargetCurrency', 'autoRefreshMinutes', 'allowHistorical', 'allowExcelPdfExport', 'enabled', 'updatedAt'])
        && data.keys().hasOnly(['id', 'preferredProvider', 'defaultBaseCurrency', 'defaultTargetCurrency', 'autoRefreshMinutes', 'allowHistorical', 'allowExcelPdfExport', 'enabled', 'updatedBy', 'updatedAt'])
        && data.id is string && data.id == settingId && data.id.size() <= 64
        && data.preferredProvider in ['open-er-api', 'frankfurter']
        && data.defaultBaseCurrency is string && data.defaultBaseCurrency.size() <= 10
        && data.defaultTargetCurrency is string && data.defaultTargetCurrency.size() <= 10
        && data.autoRefreshMinutes is number
        && data.allowHistorical is bool
        && data.allowExcelPdfExport is bool
        && data.enabled is bool
        && isOptionalString(data, 'updatedBy', 128)
        && data.updatedAt is timestamp;
    }

    function isValidGoogleConnection(data, connectionId) {
      return data.keys().hasAll(['id', 'userId', 'email', 'connectedCalendar', 'connectedSheets', 'connectedGmail', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'email', 'connectedCalendar', 'connectedSheets', 'connectedGmail', 'calendarId', 'lastSyncedAtIso', 'updatedAt'])
        && data.id is string && data.id == connectionId && data.id.size() <= 128
        && data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128
        && data.email is string && data.email.size() <= 200
        && data.connectedCalendar is bool
        && data.connectedSheets is bool
        && data.connectedGmail is bool
        && isOptionalString(data, 'calendarId', 180)
        && isOptionalString(data, 'lastSyncedAtIso', 40)
        && data.updatedAt is timestamp;
    }

    function isValidGoogleSyncJob(data, jobId) {
      return data.keys().hasAll(['id', 'userId', 'service', 'direction', 'resourceName', 'scheduleMinutes', 'enabled', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'service', 'direction', 'resourceName', 'scheduleMinutes', 'enabled', 'lastRunAtIso', 'nextRunAtIso', 'status', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == jobId && data.id.size() <= 128
        && data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128
        && data['service'] in ['calendar', 'sheets']
        && data.direction in ['export', 'import', 'two-way']
        && data.resourceName is string && data.resourceName.size() <= 180
        && data.scheduleMinutes is number
        && data.enabled is bool
        && isOptionalString(data, 'lastRunAtIso', 40)
        && isOptionalString(data, 'nextRunAtIso', 40)
        && data.status in ['idle', 'running', 'success', 'error']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidGoogleSyncLog(data, logId) {
      return data.keys().hasAll(['id', 'userId', 'service', 'action', 'status', 'itemsSynced', 'conflictsSkipped', 'ranAtIso', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'service', 'action', 'status', 'itemsSynced', 'conflictsSkipped', 'errorMessage', 'ranAtIso', 'createdAt'])
        && data.id is string && data.id == logId && data.id.size() <= 128
        && data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128
        && data['service'] in ['calendar', 'sheets', 'auth']
        && data.action is string && data.action.size() <= 180
        && data.status in ['success', 'skipped', 'error']
        && data.itemsSynced is number
        && data.conflictsSkipped is number
        && isOptionalString(data, 'errorMessage', 500)
        && data.ranAtIso is string && data.ranAtIso.size() <= 40
        && data.createdAt is timestamp;
    }

    function isValidUpdateSchedule(data, scheduleId) {
      return data.keys().hasAll(['id', 'userId', 'sourceKey', 'labelEn', 'labelBn', 'intervalMinutes', 'enabled', 'autoRetry', 'status', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'sourceKey', 'labelEn', 'labelBn', 'intervalMinutes', 'enabled', 'autoRetry', 'lastRunAtIso', 'nextRunAtIso', 'status', 'updatedAt'])
        && data.id is string && data.id == scheduleId && data.id.size() <= 128
        && data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128
        && data.sourceKey is string && data.sourceKey.size() <= 60
        && data.labelEn is string && data.labelEn.size() <= 140
        && data.labelBn is string && data.labelBn.size() <= 140
        && data.intervalMinutes is number
        && data.enabled is bool
        && data.autoRetry is bool
        && isOptionalString(data, 'lastRunAtIso', 40)
        && isOptionalString(data, 'nextRunAtIso', 40)
        && data.status in ['idle', 'success', 'error']
        && data.updatedAt is timestamp;
    }

    function isValidUpdateLog(data, logId) {
      return data.keys().hasAll(['id', 'userId', 'sourceKey', 'status', 'summary', 'ranAtIso', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'sourceKey', 'status', 'summary', 'errorMessage', 'ranAtIso', 'createdAt'])
        && data.id is string && data.id == logId && data.id.size() <= 128
        && data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128
        && data.sourceKey is string && data.sourceKey.size() <= 60
        && data.status in ['success', 'failed', 'skipped']
        && data.summary is string && data.summary.size() <= 400
        && isOptionalString(data, 'errorMessage', 500)
        && data.ranAtIso is string && data.ranAtIso.size() <= 40
        && data.createdAt is timestamp;
    }

    function isValidUserExport(data, exportId) {
      return data.keys().hasAll(['id', 'userId', 'module', 'title', 'format', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'module', 'title', 'format', 'storagePath', 'downloadUrl', 'fileSizeBytes', 'createdAt'])
        && data.id is string && data.id == exportId && data.id.size() <= 128
        && data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128
        && data.module in ['excel', 'presentation', 'report', 'currency', 'formula']
        && data.title is string && data.title.size() <= 200
        && data.format in ['xlsx', 'csv', 'pdf', 'pptx', 'json']
        && isOptionalString(data, 'storagePath', 400)
        && isOptionalString(data, 'downloadUrl', 1200)
        && (!('fileSizeBytes' in data) || (data.fileSizeBytes is number && data.fileSizeBytes >= 0))
        && data.createdAt is timestamp;
    }

    function isValidPdfFolder(data, folderId) {
      return data.keys().hasAll(['id', 'userId', 'name', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'name', 'color', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == folderId && data.id.size() <= 128
        && data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && isOptionalString(data, 'color', 20)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserStorageUsage(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'totalBytes', 'totalFiles', 'totalPages', 'quotaBytes', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'totalBytes', 'totalFiles', 'totalPages', 'quotaBytes', 'lastUploadAtIso', 'updatedAt'])
        && data.id is string && data.id == userId && data.id.size() <= 128
        && data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128
        && data.totalBytes is number && data.totalBytes >= 0
        && data.totalFiles is number && data.totalFiles >= 0
        && data.totalPages is number && data.totalPages >= 0
        && data.quotaBytes is number && data.quotaBytes >= 0
        && isOptionalString(data, 'lastUploadAtIso', 40)
        && data.updatedAt is timestamp;
    }

    function isValidTranslationHistory(data, historyId) {
      return data.keys().hasAll(['id', 'userId', 'sourceLang', 'targetLang', 'sourceText', 'translatedText', 'mode', 'provider', 'isFavourite', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'sourceLang', 'targetLang', 'detectedLang', 'sourceText', 'translatedText', 'mode', 'provider', 'isFavourite', 'createdAt'])
        && data.id is string && data.id == historyId && data.id.size() <= 128
        && data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128
        && data.sourceLang is string && data.sourceLang.size() <= 20
        && data.targetLang is string && data.targetLang.size() <= 20
        && isOptionalString(data, 'detectedLang', 20)
        && data.sourceText is string && data.sourceText.size() <= 8000
        && data.translatedText is string && data.translatedText.size() <= 8000
        && data.mode in ['standard', 'technical', 'student', 'paragraph']
        && data.provider is string && data.provider.size() <= 80
        && data.isFavourite is bool
        && data.createdAt is timestamp;
    }

    function isValidFavouriteTranslation(data, favId) {
      return data.keys().hasAll(['id', 'userId', 'sourceLang', 'targetLang', 'sourceText', 'translatedText', 'mode', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'sourceLang', 'targetLang', 'sourceText', 'translatedText', 'mode', 'createdAt'])
        && data.id is string && data.id == favId && data.id.size() <= 128
        && data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128
        && data.sourceLang is string && data.sourceLang.size() <= 20
        && data.targetLang is string && data.targetLang.size() <= 20
        && data.sourceText is string && data.sourceText.size() <= 8000
        && data.translatedText is string && data.translatedText.size() <= 8000
        && data.mode in ['standard', 'technical', 'student', 'paragraph']
        && data.createdAt is timestamp;
    }

    function isValidDictionaryHistory(data, historyId) {
      return data.keys().hasAll(['id', 'userId', 'word', 'direction', 'domain', 'meaningBn', 'englishDefinition', 'partOfSpeech', 'sourceName', 'aiExplanationGenerated', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'word', 'direction', 'domain', 'meaningBn', 'englishDefinition', 'partOfSpeech', 'phonetic', 'sourceName', 'aiExplanationGenerated', 'createdAt'])
        && data.id is string && data.id == historyId && data.id.size() <= 128
        && data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128
        && data.word is string && data.word.size() >= 1 && data.word.size() <= 120
        && data.direction in ['en-bn', 'bn-en', 'auto']
        && data.domain in ['general', 'engineering', 'scientific', 'mathematical', 'electrical', 'mechanical', 'civil']
        && data.meaningBn is string && data.meaningBn.size() <= 600
        && data.englishDefinition is string && data.englishDefinition.size() <= 1200
        && data.partOfSpeech is string && data.partOfSpeech.size() <= 60
        && isOptionalString(data, 'phonetic', 80)
        && data.sourceName is string && data.sourceName.size() <= 120
        && data.aiExplanationGenerated is bool
        && data.createdAt is timestamp;
    }

    function isValidFavouriteWord(data, favId) {
      return data.keys().hasAll(['id', 'userId', 'word', 'meaningBn', 'englishDefinition', 'partOfSpeech', 'domain', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'word', 'meaningBn', 'englishDefinition', 'partOfSpeech', 'phonetic', 'domain', 'examples', 'synonyms', 'antonyms', 'createdAt'])
        && data.id is string && data.id == favId && data.id.size() <= 128
        && data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128
        && data.word is string && data.word.size() >= 1 && data.word.size() <= 120
        && data.meaningBn is string && data.meaningBn.size() <= 600
        && data.englishDefinition is string && data.englishDefinition.size() <= 1200
        && data.partOfSpeech is string && data.partOfSpeech.size() <= 60
        && isOptionalString(data, 'phonetic', 80)
        && data.domain in ['general', 'engineering', 'scientific', 'mathematical', 'electrical', 'mechanical', 'civil']
        && (!('examples' in data) || (data.examples is list && data.examples.size() <= 5 && (data.examples.size() == 0 || (data.examples[0] is string && data.examples[0].size() <= 400))))
        && (!('synonyms' in data) || (data.synonyms is list && data.synonyms.size() <= 15 && (data.synonyms.size() == 0 || (data.synonyms[0] is string && data.synonyms[0].size() <= 80))))
        && (!('antonyms' in data) || (data.antonyms is list && data.antonyms.size() <= 15 && (data.antonyms.size() == 0 || (data.antonyms[0] is string && data.antonyms[0].size() <= 80))))
        && data.createdAt is timestamp;
    }

    function isValidCalculatorHistory(data, historyId) {
      return data.keys().hasAll(['id', 'userId', 'mode', 'expression', 'result', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'mode', 'expression', 'result', 'unit', 'steps', 'inputsSummary', 'createdAt'])
        && data.id is string && data.id == historyId && data.id.size() <= 128
        && data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128
        && data.mode in ['normal', 'scientific', 'engineering']
        && data.expression is string && data.expression.size() <= 500
        && data.result is string && data.result.size() <= 300
        && isOptionalString(data, 'unit', 40)
        && isOptionalString(data, 'steps', 2000)
        && isOptionalString(data, 'inputsSummary', 500)
        && data.createdAt is timestamp;
    }

    function isValidSuggestion(data, suggestionId) {
      return data.keys().hasAll(['id', 'userId', 'userName', 'userEmail', 'title', 'category', 'description', 'relatedModule', 'priority', 'visibility', 'status', 'voteCount', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'userName', 'userEmail', 'title', 'category', 'description', 'relatedModule', 'attachmentDataUrl', 'priority', 'visibility', 'status', 'adminReply', 'internalNote', 'isImportant', 'isDevelopmentTask', 'voteCount', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == suggestionId && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.userName is string && data.userName.size() <= 120
        && data.userEmail is string && data.userEmail.size() <= 200
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 180
        && data.category is string && data.category.size() <= 60
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 4000
        && data.relatedModule is string && data.relatedModule.size() <= 80
        && isOptionalString(data, 'attachmentDataUrl', 320000)
        && data.priority in ['low', 'medium', 'high']
        && data.visibility in ['public', 'private']
        && data.status in ['Submitted', 'Under Review', 'Accepted', 'In Development', 'Completed', 'Rejected']
        && isOptionalString(data, 'adminReply', 2000)
        && isOptionalString(data, 'internalNote', 2000)
        && isOptionalBool(data, 'isImportant')
        && isOptionalBool(data, 'isDevelopmentTask')
        && data.voteCount is number && data.voteCount >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSuggestionVote(data, voteId) {
      return data.keys().hasAll(['id', 'suggestionId', 'userId', 'createdAt'])
        && data.keys().hasOnly(['id', 'suggestionId', 'userId', 'createdAt'])
        && data.id is string && data.id == voteId && data.id.size() <= 260
        && data.suggestionId is string && data.suggestionId.size() <= 128
        && data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128
        && data.createdAt is timestamp;
    }

    function isValidDesignerInfo(data, infoId) {
      return data.keys().hasAll(['id', 'nameBn', 'nameEn', 'designationBn', 'designationEn', 'mobile', 'aboutBn', 'aboutEn', 'visionBn', 'visionEn', 'missionBn', 'missionEn', 'updatedAt'])
        && data.keys().hasOnly(['id', 'nameBn', 'nameEn', 'designationBn', 'designationEn', 'mobile', 'email', 'aboutBn', 'aboutEn', 'visionBn', 'visionEn', 'missionBn', 'missionEn', 'updatedBy', 'updatedAt'])
        && data.id is string && data.id == infoId && data.id.size() <= 64
        && data.nameBn is string && data.nameBn.size() <= 140
        && data.nameEn is string && data.nameEn.size() <= 140
        && data.designationBn is string && data.designationBn.size() <= 160
        && data.designationEn is string && data.designationEn.size() <= 160
        && data.mobile is string && data.mobile.size() <= 60
        && isOptionalString(data, 'email', 200)
        && data.aboutBn is string && data.aboutBn.size() <= 2000
        && data.aboutEn is string && data.aboutEn.size() <= 2000
        && data.visionBn is string && data.visionBn.size() <= 1000
        && data.visionEn is string && data.visionEn.size() <= 1000
        && data.missionBn is string && data.missionBn.size() <= 1000
        && data.missionEn is string && data.missionEn.size() <= 1000
        && isOptionalString(data, 'updatedBy', 128)
        && data.updatedAt is timestamp;
    }

    function isValidApiUsageLog(data, logId) {
      return data.keys().hasAll(['id', 'userId', 'service', 'status', 'charsCount', 'detail', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'service', 'status', 'charsCount', 'detail', 'createdAt'])
        && data.id is string && data.id == logId && data.id.size() <= 128
        && data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128
        && data['service'] in ['translate', 'dictionary']
        && data.status in ['success', 'error', 'setup_required']
        && data.charsCount is number && data.charsCount >= 0
        && data.detail is string && data.detail.size() <= 400
        && data.createdAt is timestamp;
    }

    function isValidUserActivityLog(data, logId) {
      return data.keys().hasAll(['id', 'userId', 'action', 'module', 'summary', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'action', 'module', 'summary', 'createdAt'])
        && data.id is string && data.id == logId && data.id.size() <= 128
        && data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128
        && data.action is string && data.action.size() <= 80
        && data.module is string && data.module.size() <= 60
        && data.summary is string && data.summary.size() <= 300
        && data.createdAt is timestamp;
    }

    // =========================================================================
    // Collection Rules
    // =========================================================================

    // Users (PII Protected)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId)
        && isVerifiedUser()
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (
            incoming().role in ['user', 'engineer']
            && incoming().status == 'active'
            && (!('accountType' in incoming()) || incoming().accountType == 'free')
            && !('storageLimitMb' in incoming())
          ) ||
          isAdmin()
        );
      allow update: if isValidId(userId)
        && isVerifiedUser()
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isOwner(userId)
            && incoming().role == existing().role
            && incoming().status == existing().status
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'photoURL', 'language', 'theme', 'primaryColor', 'secondaryColor', 'themePreset', 'timezone',
              'mobile', 'dateOfBirth', 'gender', 'country', 'division', 'district', 'city', 'address',
              'educationLevel', 'institutionName', 'department', 'subject', 'classOrSemester', 'passingYear', 'qualification',
              'profession', 'jobTitle', 'companyName', 'workDepartment', 'workExperience', 'skills', 'specialization', 'engineeringDiscipline', 'designation', 'licenseNumber',
              'loginCount', 'lastLoginAtIso', 'deletionRequested', 'deletionRequestedAtIso',
              'defaultCalculator', 'preferredUnitSystem', 'inAppNotifications', 'emailNotifications', 'profileVisibility',
              'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(userId) && isAdmin();
    }

    // Admin registry
    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId)
        && isAdmin()
        && isValidAdminMarker(incoming(), userId)
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(userId) && isAdmin();
    }

    // Roles
    match /roles/{roleId} {
      allow get: if isValidId(roleId) && isSignedIn();
      allow list: if isSignedIn();
      allow create, update: if isValidId(roleId)
        && isAdmin()
        && isValidRoleDefinition(incoming(), roleId)
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(roleId) && isAdmin();
    }

    // Categories (Public enabled read, Admin full access)
    match /categories/{categoryId} {
      allow get: if isValidId(categoryId) && (existing().enabled == true || isAdmin());
      allow list: if resource.data.enabled == true || isAdmin();
      allow create, update: if isValidId(categoryId)
        && isAdmin()
        && isValidCategory(incoming(), categoryId)
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(categoryId) && isAdmin();
    }

    // Calculators (Published read, Admin full access)
    match /calculators/{calculatorId} {
      allow get: if isValidId(calculatorId) && ((existing().enabled == true && existing().published == true) || isAdmin());
      allow list: if (resource.data.enabled == true && resource.data.published == true) || isAdmin();
      allow create, update: if isValidId(calculatorId)
        && isAdmin()
        && isValidCalculator(incoming(), calculatorId)
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(calculatorId) && isAdmin();
    }

    // Standalone Formulas (Admin managed)
    match /formulas/{formulaId} {
      allow get: if isValidId(formulaId);
      allow list: if isSignedIn();
      allow create, update: if isValidId(formulaId)
        && isAdmin()
        && isValidFormulaRecord(incoming(), formulaId)
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(formulaId) && isAdmin();
    }

    // Formula Versions (Admin or Custom Formula Owner history & rollback)
    match /formulaVersions/{versionId} {
      allow get: if isValidId(versionId) && (isAdmin() || (isSignedIn() && existing().createdBy == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.createdBy == request.auth.uid);
      allow create: if isValidId(versionId)
        && (isAdmin() || (isVerifiedUser() && incoming().createdBy == request.auth.uid))
        && isValidFormulaVersion(incoming(), versionId)
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(versionId) && (isAdmin() || (isSignedIn() && existing().createdBy == request.auth.uid));
    }

    // Units (Public enabled read, Admin write)
    match /units/{unitId} {
      allow get: if isValidId(unitId) && (existing().enabled == true || isAdmin());
      allow list: if resource.data.enabled == true || isAdmin();
      allow create, update: if isValidId(unitId)
        && isAdmin()
        && isValidUnit(incoming(), unitId)
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(unitId) && isAdmin();
    }

    // Calculation History (Owner scoped, Admin readable for telemetry)
    match /calculationHistory/{historyId} {
      allow get: if isValidId(historyId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(historyId)
        && isVerifiedUser()
        && isValidCalculationHistory(incoming(), historyId)
        && incoming().createdAt == request.time;
      allow update: if isValidId(historyId)
        && isVerifiedUser()
        && existing().userId == request.auth.uid
        && isValidCalculationHistory(incoming(), historyId)
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['isSaved', 'note']);
      allow delete: if isValidId(historyId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    // Report Templates (Public enabled read, Admin write)
    match /reportTemplates/{templateId} {
      allow get: if isValidId(templateId) && (existing().enabled == true || isAdmin());
      allow list: if resource.data.enabled == true || isAdmin();
      allow create, update: if isValidId(templateId)
        && isAdmin()
        && isValidReportTemplate(incoming(), templateId)
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(templateId) && isAdmin();
    }

    // Generated Reports (Owner scoped)
    match /generatedReports/{reportId} {
      allow get: if isValidId(reportId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isValidId(reportId)
        && isVerifiedUser()
        && isValidGeneratedReport(incoming(), reportId)
        && incoming().createdAt == request.time;
      allow update: if isValidId(reportId)
        && isVerifiedUser()
