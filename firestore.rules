          && isValidId(pageId)
          && isVerifiedUser()
          && isValidPdfPage(incoming(), docId, pageId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && get(/databases/$(database)/documents/pdfDocuments/$(docId)).data.userId == request.auth.uid;
        allow update: if isValidId(docId)
          && isValidId(pageId)
          && isVerifiedUser()
          && existing().userId == request.auth.uid
          && isValidPdfPage(incoming(), docId, pageId)
          && incoming().documentId == existing().documentId
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['text', 'isScanned', 'ocrApplied', 'diagramSummary', 'thumbnailDataUrl', 'updatedAt']);
        allow delete: if isValidId(docId) && isValidId(pageId) && isSignedIn() && existing().userId == request.auth.uid;
