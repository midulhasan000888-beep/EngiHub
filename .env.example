# GEMINI_API_KEY: Required for Gemini AI API calls (free-tier compatible default AI provider).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional Additional AI Providers (Server-side only; never expose to frontend)
# OPENAI_API_KEY="sk-..."
# ANTHROPIC_API_KEY="sk-ant-..."

# Cloudflare R2 Object Storage (S3-compatible, zero Google Cloud Billing required)
# When omitted in local development, files fall back safely to local .storage-data/
# R2_ACCOUNT_ID="your_cloudflare_account_id"
# R2_ACCESS_KEY_ID="your_r2_access_key_id"
# R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
# R2_BUCKET_NAME="engihub-user-files"
# R2_PUBLIC_URL="https://pub-xxxx.r2.dev"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Independent Cloudflare Pages + External Backend Deployment (optional)
# Set VITE_API_BASE_URL in Cloudflare Pages build env if hosting dist/ separately from server.ts
# VITE_API_BASE_URL="https://your-engihub-api.onrender.com"
# Set CORS_ORIGINS on the backend server to allow your Cloudflare Pages frontend origin
# CORS_ORIGINS="https://your-engihub.pages.dev"

# Optional Server-Side Email Relay (users can also send directly via Gmail OAuth)
# RESEND_API_KEY="MY_RESEND_API_KEY"
# EMAIL_FROM="reports@yourdomain.com"
